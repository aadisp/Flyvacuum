---
import { Image } from 'astro:assets';
import RangeBar from './RangeBar.astro';
import { productImage } from '../data/images';

interface Props {
  href: string;
  title: string;
  text?: string;
  range: [number, number] | null;
  rangeLabel: string | null;
  imageKey?: string;
}
const { href, title, text, range, rangeLabel, imageKey } = Astro.props;
const image = imageKey ? productImage(imageKey) : undefined;
---

<a class="card" href={href}>
  {image && <Image src={image} alt="" width={600} class="thumb" />}
  <div class="body">
    <h3>{title}</h3>
    {text && <p>{text}</p>}
    <RangeBar range={range} />
    <small>{rangeLabel ?? 'Custom built to your requirement'}</small>
  </div>
</a>

<style>
  .card { display: flex; flex-direction: column; background: var(--panel); border: 1px solid var(--line); text-decoration: none; height: 100%; }
  .card:hover { border-color: var(--red); }
  .card :global(.thumb) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-bottom: 1px solid var(--line); }
  .body { display: flex; flex-direction: column; flex: 1; padding: 22px; }
  h3 { margin-bottom: 10px; }
  p { color: var(--mute); font-size: 15px; margin: 0 0 18px; flex: 1; }
  small { color: var(--mute); font-size: 13px; margin-top: 10px; }
</style>
