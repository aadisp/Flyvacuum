---
import RangeBar from './RangeBar.astro';
import { ranged, SCALE } from '../data/products';

const span = SCALE.max - SCALE.min;
const ticks = [0, 500, 1000, 1500, 2000, 2500];
---

<div class="ladder">
  <h3>What we build, by temperature</h3>
  <ul>
    {ranged.map((p) => (
      <li>
        <a href={`/products/${p.slug}`}>
          <span class="name">{p.label}</span>
          <RangeBar range={p.range} />
          <span class="val">{p.rangeLabel}</span>
        </a>
      </li>
    ))}
  </ul>
  <div class="scale" aria-hidden="true">
    <span></span>
    <div class="ticks">
      {ticks.map((t) => <i style={`left:${((t - SCALE.min) / span) * 100}%`}>{t}</i>)}
    </div>
    <span class="unit">°C</span>
  </div>
</div>

<style>
  .ladder { background: var(--panel); border: 1px solid var(--line); padding: 28px 32px; margin-top: 48px; }
  h3 { margin-bottom: 8px; }
  ul { list-style: none; margin: 0; padding: 0; }
  li { border-top: 1px solid var(--line); }
  li:first-child { border-top: 0; }
  a { display: grid; grid-template-columns: 210px 1fr 130px; gap: 16px; align-items: center; padding: 14px 0; text-decoration: none; }
  a:hover .name { color: var(--red); }
  .name { font-weight: 500; }
  .val { font-size: 14px; color: var(--mute); text-align: right; }
  .scale { display: grid; grid-template-columns: 210px 1fr 130px; gap: 16px; font-size: 12px; color: var(--mute); }
  .ticks { position: relative; height: 18px; }
  .ticks i { position: absolute; font-style: normal; transform: translateX(-50%); }
  .unit { text-align: right; }
  @media (max-width: 700px) {
    .ladder { padding: 22px 18px; }
    a { grid-template-columns: 1fr; gap: 6px; }
    .val { text-align: left; }
    .scale { grid-template-columns: 1fr; }
    .scale > span:first-child, .unit { display: none; }
  }
</style>
