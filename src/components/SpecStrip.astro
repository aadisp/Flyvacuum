---
import type { Spec } from '../data/products';
interface Props { specs: Spec[] }
const { specs } = Astro.props;
---

<dl class="specs">
  {specs.map(([label, value]) => (
    <div>
      <dt>{label}</dt>
      <dd>{value}</dd>
    </div>
  ))}
</dl>

<style>
  .specs { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); margin: 0; background: var(--panel); border: 1px solid var(--line); }
  .specs div { padding: 18px 22px; border-left: 1px solid var(--line); }
  .specs div:first-child { border-left: 0; }
  dt { font-size: 14px; color: var(--mute); }
  dd { margin: 4px 0 0; font: 800 28px/1.15 var(--font-head); color: var(--indigo-dk); }
  @media (max-width: 640px) {
    .specs div { border-left: 0; border-top: 1px solid var(--line); }
    .specs div:first-child { border-top: 0; }
  }
</style>
