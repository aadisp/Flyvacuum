---
interface Props { items: { label: string; href?: string }[] }
const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <div class="wrap">
    <ol>
      {items.map((item, i) => (
        <li>
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
          {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
        </li>
      ))}
    </ol>
  </div>
</nav>

<style>
  .crumbs { padding: 22px 0 0; font-size: 14px; color: var(--mute); }
  ol { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  a { color: var(--mute); }
  a:hover { color: var(--red); }
  .sep { margin-left: 8px; }
</style>
