---
import { site } from '../data/site';

interface Props { title: string; text: string }
const { title, text } = Astro.props;
---

<section class="band">
  <div class="wrap row">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn-red" href="/contact">Get a quote</a>
      <a class="btn btn-line" href={site.phoneHref}>Call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .band { background: var(--indigo-dk); color: #fff; padding: 64px 0; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 28px; flex-wrap: wrap; }
  h2 { color: #fff; }
  p { color: #b4b7d6; margin: 10px 0 0; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
