---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { nav } from '../data/site';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href="/" aria-label="Flyvacuum Technologies, home">
      <Image src={logo} alt="" height={56} />
      <span>Flyvacuum Technologies</span>
    </a>
    <button class="menu-btn" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
        <li><a class="btn btn-red" href="/contact">Get a quote</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--panel); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand :global(img) { width: auto; height: 56px; }
  .brand span { font: 800 26px/1 var(--font-head); letter-spacing: 0.02em; color: var(--indigo); }
  ul { display: flex; align-items: center; gap: 26px; list-style: none; margin: 0; padding: 0; }
  nav a:not(.btn) { text-decoration: none; font-weight: 500; font-size: 15px; padding: 6px 0; border-bottom: 2px solid transparent; }
  nav a:not(.btn):hover, nav a[aria-current] { border-bottom-color: var(--red); }
  .menu-btn { display: none; background: none; border: 1.5px solid var(--indigo); color: var(--indigo); padding: 8px 14px; font: 600 15px var(--font-body); border-radius: 2px; cursor: pointer; }
  @media (max-width: 860px) {
    .brand span { font-size: 21px; }
    .menu-btn { display: inline-flex; }
    nav { display: none; position: absolute; left: 0; right: 0; top: 100%; background: var(--panel); border-bottom: 1px solid var(--line); padding: 12px 24px 22px; }
    nav.open { display: block; }
    ul { flex-direction: column; align-items: flex-start; gap: 10px; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const menu = document.querySelector<HTMLElement>('#site-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('open', !open);
  });
</script>
