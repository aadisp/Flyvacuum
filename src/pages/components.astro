---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBand from '../components/CtaBand.astro';
import { statSync } from 'node:fs';
import { componentGroups, datasheetCount } from '../data/components';

const sizeOf = (href: string) => {
  try {
    return Math.round(statSync('public' + href).size / 1024) + ' KB';
  } catch {
    return '';
  }
};
---

<BaseLayout
  title="Components"
  description="Flanges, fittings, valves and baffles for vacuum ovens and furnaces. Download datasheets, or ask us for customised components."
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Components' }]} />
  <PageIntro
    title="Components"
    lead="Components and accessories for all types of vacuum ovens and furnaces, including diffusion pumps, gate valves, right angle valves, chevron baffles and flanges and fittings. We also manufacture customised components and accessories."
  >
    <ul class="jump" aria-label="Jump to a group">
      {componentGroups.map((g) => (
        <li><a href={`#${g.id}`}>{g.title} <span>{g.items.length}</span></a></li>
      ))}
    </ul>
  </PageIntro>

  <section class="section">
    <div class="wrap">
      {componentGroups.map((g) => (
        <div class="group" id={g.id}>
          <div class="head">
            <h2>{g.title}</h2>
            <p>{g.text}</p>
          </div>
          <ul class="sheets">
            {g.items.map((item) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener">
                  <span class="name">
                    {item.name}
                    {item.series && <small>{item.series}</small>}
                  </span>
                  <span class="dl">
                    Datasheet <span class="kb">{sizeOf(item.href)}</span>
                    <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
                      <path d="M10 3v9m0 0l-3.5-3.5M10 12l3.5-3.5M4 16h12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="sr">PDF, opens in a new tab</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <p class="note">
        {datasheetCount} datasheets in total. Looking for diffusion pumps, or a part that is not listed?{' '}
        <a href="/contact">Ask us</a>, since we also make customised components.
      </p>
    </div>
  </section>

  <CtaBand title="Need a part that is not listed?" text="Send us the drawing or the specification. We build customised components and accessories." />
</BaseLayout>

<style>
  .jump { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; margin: 28px 0 0; padding: 0; }
  .jump a { display: inline-flex; gap: 8px; align-items: center; padding: 8px 16px; background: var(--panel); border: 1px solid var(--line); border-radius: 999px; text-decoration: none; font-weight: 500; font-size: 15px; }
  .jump a:hover { border-color: var(--red); }
  .jump span { background: var(--bg); color: var(--mute); font-size: 13px; padding: 0 8px; border-radius: 999px; }

  .group { display: grid; grid-template-columns: 300px 1fr; gap: 48px; padding: 40px 0; border-top: 1px solid var(--line); scroll-margin-top: 90px; }
  .group:first-child { border-top: 0; padding-top: 0; }
  .head p { color: var(--mute); margin: 12px 0 0; font-size: 16px; }
  .sheets { list-style: none; margin: 0; padding: 0; background: var(--panel); border: 1px solid var(--line); }
  .sheets li + li { border-top: 1px solid var(--line); }
  .sheets a { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 18px 22px; text-decoration: none; }
  .sheets a:hover { background: var(--bg); }
  .sheets a:hover .dl { color: var(--red); }
  .name { font-weight: 500; }
  .name small { display: block; font-weight: 400; font-size: 14px; color: var(--mute); }
  .dl { display: inline-flex; align-items: center; gap: 8px; color: var(--indigo); font-weight: 600; font-size: 15px; white-space: nowrap; }
  .kb { color: var(--mute); font-weight: 400; font-size: 13px; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .note { margin: 24px 0 0; color: var(--mute); }
  .note a { color: var(--indigo); font-weight: 500; }

  @media (max-width: 860px) { .group { grid-template-columns: 1fr; gap: 20px; } }
</style>
